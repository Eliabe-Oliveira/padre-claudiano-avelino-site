---
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/inter/wght.css";
import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/pages.css";
import "../styles/reflections.css";
import "../styles/editorial.css";
import "../styles/renaissance.css";
import "../styles/utilities.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultSocialImage from "../assets/photos/final/padre-claudiano-retrato.png";
import SkipLink from "../components/accessibility/SkipLink.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import {
  buildHomeStructuredData,
  buildPageStructuredData,
  buildProfileStructuredData,
  type StructuredData,
} from "../lib/structured-data";
import { buildAbsoluteUrl, buildInternalUrl } from "../lib/urls";

interface Props {
  title: string;
  description: string;
  currentPath: string;
  showSiteChrome?: boolean;
  canonicalPath?: string | false;
  pageType?: "website" | "article" | "profile";
  noindex?: boolean;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  section?: string;
  structuredDataType?: "home" | "profile" | "contact" | "collection";
  structuredData?: StructuredData;
}

const {
  title,
  description,
  currentPath,
  showSiteChrome = true,
  canonicalPath: canonicalPathProp,
  pageType = "website",
  noindex = false,
  socialImage = defaultSocialImage,
  socialImageAlt,
  publishedAt,
  updatedAt,
  section,
  structuredDataType,
  structuredData: customStructuredData,
} = Astro.props;
const canonicalPath =
  canonicalPathProp === false ? undefined : (canonicalPathProp ?? currentPath);
const site = Astro.site ?? new URL("http://localhost:4321/");
const pageUrl = canonicalPath
  ? buildAbsoluteUrl(buildInternalUrl(canonicalPath), site)
  : undefined;
const publicRootUrl = buildAbsoluteUrl(buildInternalUrl("/"), site);
const generatedPersonImage = await getImage({ src: defaultSocialImage });
const personImageUrl = buildAbsoluteUrl(
  buildInternalUrl(generatedPersonImage.src),
  site,
);
const page = pageUrl ? { url: pageUrl, name: title, description } : undefined;
const person = { url: publicRootUrl, image: personImageUrl };
const generatedStructuredData =
  customStructuredData ??
  (page && structuredDataType === "home"
    ? buildHomeStructuredData(page, person)
    : page && structuredDataType === "profile"
      ? buildProfileStructuredData(page, person)
      : page && structuredDataType === "contact"
        ? buildPageStructuredData("ContactPage", page)
        : page && structuredDataType === "collection"
          ? buildPageStructuredData("CollectionPage", page)
          : undefined);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      {title}
      {description}
      {canonicalPath}
      {pageType}
      {noindex}
      {socialImage}
      {socialImageAlt}
      {publishedAt}
      {updatedAt}
      {section}
    />
    {generatedStructuredData && <JsonLd data={generatedStructuredData} />}
  </head>
  <body class:list={{ "page-home": currentPath === "/" }}>
    <SkipLink />
    {showSiteChrome && <SiteHeader {currentPath} />}
    <main id="conteudo-principal" tabindex="-1">
      <slot />
    </main>
    {showSiteChrome && <SiteFooter />}
  </body>
</html>
