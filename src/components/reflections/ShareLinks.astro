---
import { buildReflectionEmailShareUrl } from "../../lib/reflections";

interface Props {
  title: string;
}

const { title } = Astro.props;
const emailHref = buildReflectionEmailShareUrl(title);
---

<section class="share-links" data-share-links data-title={title}>
  <h2>Compartilhar</h2>
  <div class="share-links__actions">
    <button type="button" data-copy-link>Copiar link</button>
    <a href={emailHref} data-email-share>Compartilhar por e-mail</a>
  </div>
  <p class="share-links__status" role="status" aria-live="polite"></p>
</section>

<script src="../../scripts/share-links.ts"></script>

<style>
  .share-links {
    padding-block: var(--space-7);
    border-block: var(--border-width-default) solid var(--color-border-default);
  }

  .share-links h2 {
    margin-block-end: var(--space-5);
    font-size: var(--font-size-h3);
  }

  .share-links__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .share-links button,
  .share-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    color: var(--color-brand-primary);
    background: transparent;
    border: var(--border-width-default) solid var(--color-brand-primary);
    border-radius: var(--radius-small);
    font-family: var(--font-family-interface);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .share-links button:hover,
  .share-links a:hover {
    color: var(--color-brand-hover);
    background: var(--color-brand-soft);
  }

  .share-links__status {
    min-height: 1.5em;
    margin-block-start: var(--space-3);
    color: var(--color-text-secondary);
    font-family: var(--font-family-interface);
    font-size: var(--font-size-small);
  }
</style>
