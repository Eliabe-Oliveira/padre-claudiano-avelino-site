---
import Container from "../base/Container.astro";

interface Props {
  id: string;
  label: string;
  title: string;
  intro: string;
}

const { id, label, title, intro } = Astro.props;
---

<Container as="section" variant="opening" {id} class="institutional-intro">
  <p class="type-meta">{label}</p>
  <h1>{title}</h1>
  <p class="type-body-large">{intro}</p>
</Container>
