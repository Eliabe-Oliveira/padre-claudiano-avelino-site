---
import { Picture } from "astro:assets";
import { siteMedia } from "../../config/media";
import SacredEncounter from "../art/SacredEncounter.astro";
import ButtonLink from "../base/ButtonLink.astro";
import Container from "../base/Container.astro";
---

<Container as="section" id="inicio-abertura" class="home-hero">
  <div class="home-hero__content">
    <p class="type-meta">Espiritualidade e vida cotidiana</p>
    <h1>Padre <i>Claudiano</i> Avelino</h1>
    <p class="home-hero__positioning">
      Uma palavra para iluminar a vida cotidiana
    </p>
    <p class="type-body-large">
      Reflexões e breves homilias sobre espiritualidade católica, oração e
      encontro com a Palavra de Deus.
    </p>
    <div class="page-actions">
      <ButtonLink href="/reflexoes/">Ler as reflexões</ButtonLink>
      <ButtonLink href="/videos/" variant="secondary">
        Assistir à Homilia de 1 minuto
      </ButtonLink>
    </div>
  </div>
  <div class="home-hero__visual">
    <span class="home-hero__accent" aria-hidden="true"></span>
    <SacredEncounter />
    {
      siteMedia.homeHero && (
        <div class="home-hero__portrait">
          <Picture
            class="home-hero__photo"
            src={siteMedia.homeHero.src}
            alt={siteMedia.homeHero.alt}
            formats={["avif", "webp"]}
            widths={[240, 360, 480]}
            sizes="(max-width: 55.999rem) 9rem, 14rem"
            quality={80}
            loading="eager"
            fetchpriority="high"
            style={`object-position: ${siteMedia.homeHero.objectPosition}`}
          />
        </div>
      )
    }
  </div>
</Container>
