---
import Container from "../base/Container.astro";
import MobileNavigation from "./MobileNavigation.astro";
import { buildInternalUrl, stripBasePath } from "../../lib/urls";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const logicalCurrentPath = stripBasePath(currentPath);
const items = [
  { label: "Início", href: "/" },
  { label: "Sobre", href: "/sobre/" },
  { label: "Reflexões", href: "/reflexoes/" },
  { label: "Vídeos", href: "/videos/" },
  { label: "Contato", href: "/contato/" },
];
---

<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a
        class="site-header__name"
        href={buildInternalUrl("/")}
        aria-label="Padre Claudiano Avelino — Início"
      >
        <span>Padre</span>
        <strong>Claudiano Avelino</strong>
      </a>

      <nav
        class="site-header__desktop-navigation"
        aria-label="Navegação principal"
      >
        <ul role="list">
          {
            items.map((item) => (
              <li>
                <a
                  href={buildInternalUrl(item.href)}
                  aria-current={
                    logicalCurrentPath === item.href ? "page" : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <MobileNavigation currentPath={logicalCurrentPath} />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    color: var(--color-sacred-ivory);
    background-color: var(--color-sacred-green-950);
    background-image: var(--texture-painted-green);
    background-position: center;
    background-size: cover;
    border-block-end: var(--border-width-default) solid
      var(--color-sacred-rule-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 7rem;
    gap: var(--space-5);
  }

  .site-header__name {
    display: grid;
    max-width: 19rem;
    color: var(--color-sacred-gold-light);
    font-family: var(--font-family-editorial);
    font-size: 0.75rem;
    font-weight: 520;
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-header__name strong {
    max-width: 12ch;
    font-size: clamp(1.3rem, 1.05rem + 0.7vw, 1.75rem);
    font-weight: 480;
    letter-spacing: 0.01em;
    line-height: 0.92;
  }

  .site-header__desktop-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2vw, var(--space-6));
  }

  .site-header__desktop-navigation a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-sacred-ivory);
    font-family: var(--font-family-editorial);
    font-size: 1rem;
    font-weight: 450;
    text-decoration: none;
  }

  .site-header__desktop-navigation a::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.25rem;
    height: 2px;
    content: "";
    background: var(--color-sacred-gold-light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .site-header__desktop-navigation a:hover,
  .site-header__desktop-navigation a[aria-current="page"] {
    color: var(--color-sacred-gold-light);
  }

  .site-header__desktop-navigation a:hover::after,
  .site-header__desktop-navigation a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (max-width: 55.999rem) {
    .site-header__inner {
      min-height: 5.5rem;
    }

    .site-header__desktop-navigation {
      display: none;
    }

    .site-header__name {
      max-width: 11rem;
      font-size: 0.625rem;
    }

    .site-header__name strong {
      font-size: 1.1rem;
    }
  }
</style>
