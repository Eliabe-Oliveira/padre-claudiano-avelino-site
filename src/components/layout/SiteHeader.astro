---
import Container from "../base/Container.astro";
import MobileNavigation from "./MobileNavigation.astro";
import { buildInternalUrl, stripBasePath } from "../../lib/urls";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const logicalCurrentPath = stripBasePath(currentPath);
const items = [
  { label: "Início", href: "/" },
  { label: "Sobre", href: "/sobre/" },
  { label: "Reflexões", href: "/reflexoes/" },
  { label: "Vídeos", href: "/videos/" },
  { label: "Contato", href: "/contato/" },
];
---

<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a
        class="site-header__name"
        href={buildInternalUrl("/")}
        aria-label="Padre Claudiano Avelino — Início"
      >
        Padre Claudiano Avelino
      </a>

      <nav
        class="site-header__desktop-navigation"
        aria-label="Navegação principal"
      >
        <ul role="list">
          {
            items.map((item) => (
              <li>
                <a
                  href={buildInternalUrl(item.href)}
                  aria-current={
                    logicalCurrentPath === item.href ? "page" : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <MobileNavigation currentPath={logicalCurrentPath} />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    background: rgb(245 241 232 / 96%);
    border-block-end: var(--border-width-default) solid
      var(--color-border-default);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 6rem;
    gap: var(--space-5);
  }

  .site-header__name {
    max-width: 20rem;
    color: var(--color-text-primary);
    font-family: var(--font-family-editorial);
    font-size: clamp(1.25rem, 1.05rem + 0.5vw, 1.625rem);
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    text-wrap: balance;
  }

  .site-header__desktop-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2vw, var(--space-6));
  }

  .site-header__desktop-navigation a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    font-weight: 650;
    text-decoration: none;
  }

  .site-header__desktop-navigation a::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.25rem;
    height: 2px;
    content: "";
    background: var(--color-accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .site-header__desktop-navigation a:hover,
  .site-header__desktop-navigation a[aria-current="page"] {
    color: var(--color-brand-primary);
  }

  .site-header__desktop-navigation a:hover::after,
  .site-header__desktop-navigation a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (max-width: 55.999rem) {
    .site-header__inner {
      min-height: 5rem;
    }

    .site-header__desktop-navigation {
      display: none;
    }

    .site-header__name {
      max-width: 13rem;
      font-size: 1.125rem;
    }
  }
</style>
