---
import Container from "../base/Container.astro";
import OrnamentalDivider from "../art/OrnamentalDivider.astro";
import { siteConfig } from "../../config/site";
import { buildMailto } from "../../lib/contact";
import { buildInternalUrl } from "../../lib/urls";

const items = [
  { label: "Início", href: "/" },
  { label: "Sobre", href: "/sobre/" },
  { label: "Reflexões", href: "/reflexoes/" },
  { label: "Vídeos", href: "/videos/" },
  { label: "Contato", href: "/contato/" },
];
const contactHref = siteConfig.contactEmail
  ? buildMailto(siteConfig.contactEmail, siteConfig.contactSubject)
  : undefined;
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__identity flow">
        <p class="site-footer__name">Padre Claudiano Avelino</p>
        <OrnamentalDivider inverted />
        <p>Espiritualidade, reflexão e encontro com a Palavra.</p>
      </div>

      <nav aria-label="Navegação do rodapé">
        <p class="site-footer__label">Navegação</p>
        <ul role="list">
          {
            items.map((item) => (
              <li>
                <a href={buildInternalUrl(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flow">
        <p class="site-footer__label">Contato</p>
        {
          siteConfig.contactEmail && contactHref ? (
            <a class="site-footer__contact" href={contactHref}>
              {siteConfig.contactEmail}
            </a>
          ) : (
            <p>E-mail de contato a definir</p>
          )
        }
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>Site pessoal de Padre Claudiano Avelino.</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: clamp(var(--space-9), 8vw, var(--space-11)) var(--space-6);
    color: var(--color-text-inverse);
    background-color: var(--color-sacred-green-950);
    background-image: var(--texture-painted-green);
    background-position: center;
    background-size: cover;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) repeat(2, minmax(10rem, 0.7fr));
    gap: var(--space-7);
  }

  .site-footer__identity {
    --flow-space: var(--space-3);
    max-width: 27rem;
    font-family: var(--font-family-editorial);
    font-size: var(--font-size-body-editorial);
  }

  .site-footer__name {
    max-width: 12ch;
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1;
  }

  .site-footer__label {
    margin-block-end: var(--space-3);
    color: var(--color-sacred-gold-light);
    font-size: var(--font-size-meta);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-inverse);
    text-underline-offset: 0.2em;
  }

  .site-footer__contact {
    color: var(--color-text-inverse);
    overflow-wrap: anywhere;
    text-underline-offset: 0.2em;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block-start: var(--space-6);
    margin-block-start: var(--space-7);
    border-block-start: var(--border-width-default) solid
      var(--color-sacred-rule-dark);
    font-size: var(--font-size-small);
  }

  @media (max-width: 47.999rem) {
    .site-footer {
      padding-block-start: var(--space-8);
    }

    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .site-footer__bottom {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
