---
import { buildInternalUrl, stripBasePath } from "../../lib/urls";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const logicalCurrentPath = stripBasePath(currentPath);
const items = [
  { label: "Início", href: "/" },
  { label: "Sobre", href: "/sobre/" },
  { label: "Reflexões", href: "/reflexoes/" },
  { label: "Vídeos", href: "/videos/" },
  { label: "Contato", href: "/contato/" },
];
---

<details class="mobile-navigation" data-mobile-navigation>
  <summary
    class="mobile-navigation__toggle"
    role="button"
    aria-expanded="false"
    aria-controls="mobile-navigation-panel"
    data-menu-toggle
  >
    <span data-menu-label>Menu</span>
  </summary>

  <div
    class="mobile-navigation__panel"
    id="mobile-navigation-panel"
    data-menu-panel
  >
    <nav aria-label="Navegação principal móvel">
      <ul role="list">
        {
          items.map((item) => (
            <li>
              <a
                href={buildInternalUrl(item.href)}
                aria-current={
                  logicalCurrentPath === item.href ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</details>

<script src="../../scripts/mobile-navigation.ts"></script>

<style>
  .mobile-navigation {
    display: none;
  }

  .mobile-navigation__toggle {
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    color: var(--color-sacred-gold-light);
    background: transparent;
    border: var(--border-width-default) solid var(--color-sacred-gold);
    border-radius: 0.125rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .mobile-navigation__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-navigation__toggle:hover {
    background: rgb(196 161 92 / 10%);
  }

  .mobile-navigation__panel {
    position: absolute;
    z-index: 20;
    inset-block-start: 100%;
    inset-inline: 0;
    padding: var(--space-3) var(--page-gutter) var(--space-5);
    background-color: var(--color-sacred-ivory);
    background-image: var(--texture-aged-ivory);
    border-block-end: var(--border-width-default) solid
      var(--color-border-default);
  }

  .mobile-navigation:not([open]) .mobile-navigation__panel {
    display: none;
  }

  .mobile-navigation__panel ul {
    display: grid;
  }

  .mobile-navigation__panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-text-primary);
    font-weight: 600;
    text-decoration: none;
    border-block-end: var(--border-width-default) solid
      var(--color-border-default);
  }

  .mobile-navigation__panel a[aria-current="page"] {
    color: var(--color-sacred-green-900);
    box-shadow: inset 3px 0 0 var(--color-sacred-gold);
  }

  @media (max-width: 55.999rem) {
    .mobile-navigation {
      display: block;
    }
  }
</style>
