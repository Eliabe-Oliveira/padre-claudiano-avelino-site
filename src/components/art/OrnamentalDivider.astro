---
interface Props {
  class?: string;
  inverted?: boolean;
}

const { class: className, inverted = false } = Astro.props;
---

<span
  class:list={[
    "ornamental-divider",
    inverted && "ornamental-divider--inverted",
    className,
  ]}
  aria-hidden="true"
>
  <span class="ornamental-divider__mark"></span>
</span>

<style>
  .ornamental-divider {
    display: grid;
    grid-template-columns: minmax(2.5rem, 1fr) auto minmax(2.5rem, 1fr);
    align-items: center;
    width: min(100%, 10rem);
    gap: var(--space-2);
    color: var(--color-sacred-gold);
  }

  .ornamental-divider::before,
  .ornamental-divider::after {
    height: 1px;
    content: "";
    background: currentcolor;
  }

  .ornamental-divider__mark {
    width: 0.45rem;
    aspect-ratio: 1;
    border: 1px solid currentcolor;
    transform: rotate(45deg);
  }

  .ornamental-divider--inverted {
    color: var(--color-sacred-gold-light);
  }
</style>
