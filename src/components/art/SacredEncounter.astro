---
import { Picture } from "astro:assets";
import creationHands from "../../assets/art/public-domain/michelangelo-hands-cutout.png";
---

<div class="sacred-encounter" aria-hidden="true" data-sacred-encounter>
  <div class="sacred-encounter__fragment sacred-encounter__fragment--human">
    <Picture
      class="sacred-encounter__image"
      src={creationHands}
      alt=""
      formats={["avif", "webp"]}
      widths={[480, 720, 1080, 1451]}
      sizes="(max-width: 55.999rem) 92vw, 44rem"
      quality={82}
      loading="eager"
    />
  </div>
  <div class="sacred-encounter__fragment sacred-encounter__fragment--divine">
    <Picture
      class="sacred-encounter__image"
      src={creationHands}
      alt=""
      formats={["avif", "webp"]}
      widths={[480, 720, 1080, 1451]}
      sizes="(max-width: 55.999rem) 92vw, 44rem"
      quality={82}
      loading="eager"
    />
  </div>
  <span class="sacred-encounter__patina"></span>
</div>
