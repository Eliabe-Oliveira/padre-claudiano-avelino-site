---
import { buildInternalUrl } from "../../lib/urls";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
  target?: string;
  rel?: string;
  "aria-label"?: string;
  class?: string;
}

const {
  href: rawHref,
  variant = "primary",
  target,
  rel,
  "aria-label": ariaLabel,
  class: className,
} = Astro.props;
const href = buildInternalUrl(rawHref);
---

<a
  class:list={["button-link", `button-link--${variant}`, className]}
  {href}
  {target}
  {rel}
  aria-label={ariaLabel}
>
  <slot />
</a>

<style>
  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: var(--space-3) var(--space-5);
    border: var(--border-width-default) solid var(--color-brand-primary);
    border-radius: 0.125rem;
    font-family: var(--font-family-interface);
    font-size: var(--font-size-small);
    font-weight: 650;
    letter-spacing: 0.055em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .button-link--primary {
    color: var(--color-sacred-green-950);
    background: var(--color-sacred-gold-light);
    border-color: var(--color-sacred-gold-light);
  }

  .button-link--primary:hover {
    color: var(--color-sacred-green-950);
    background: var(--color-sacred-ivory);
    border-color: var(--color-sacred-gold);
  }

  .button-link--secondary {
    color: var(--color-sacred-green-900);
    background: transparent;
    border-color: var(--color-sacred-gold);
  }

  .button-link--secondary:hover {
    color: var(--color-sacred-green-950);
    background: rgb(154 120 59 / 10%);
    border-color: var(--color-sacred-gold);
  }

  .button-link:active {
    transform: translateY(2px);
  }
</style>
