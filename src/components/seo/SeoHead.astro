---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultSocialImage from "../../assets/photos/final/padre-claudiano-retrato.png";
import { buildAbsoluteUrl, buildInternalUrl } from "../../lib/urls";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageType?: "website" | "article" | "profile";
  noindex?: boolean;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  section?: string;
}

const {
  title,
  description,
  canonicalPath,
  pageType = "website",
  noindex = false,
  socialImage = defaultSocialImage,
  socialImageAlt = "Padre Claudiano Avelino em retrato, olhando para a câmera.",
  publishedAt,
  updatedAt,
  section,
} = Astro.props;
const site = Astro.site ?? new URL("http://localhost:4321/");
const canonicalUrl = canonicalPath
  ? buildAbsoluteUrl(buildInternalUrl(canonicalPath), site)
  : undefined;
const openGraphUrl =
  canonicalUrl ?? buildAbsoluteUrl(buildInternalUrl(Astro.url.pathname), site);
const generatedSocialImage = await getImage({ src: socialImage });
const socialImageUrl = buildAbsoluteUrl(
  buildInternalUrl(generatedSocialImage.src),
  site,
);
const faviconUrl = buildInternalUrl("/favicon.svg");
const sitemapUrl = buildAbsoluteUrl(
  buildInternalUrl("/sitemap-index.xml"),
  site,
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
<meta name="theme-color" content="#F5F1E8" />
<link rel="icon" type="image/svg+xml" href={faviconUrl} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{!noindex && <link rel="sitemap" href={sitemapUrl} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={pageType} />
<meta property="og:url" content={openGraphUrl} />
<meta property="og:site_name" content="Padre Claudiano Avelino" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:image" content={socialImageUrl} />
<meta
  property="og:image:width"
  content={String(generatedSocialImage.options.width)}
/>
<meta
  property="og:image:height"
  content={String(generatedSocialImage.options.height)}
/>
<meta property="og:image:alt" content={socialImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content={socialImageAlt} />

{
  pageType === "article" && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )
}
{
  pageType === "article" && updatedAt && (
    <meta property="article:modified_time" content={updatedAt.toISOString()} />
  )
}
{
  pageType === "article" && section && (
    <meta property="article:section" content={section} />
  )
}
