---
import ClosingInvitation from "../components/sections/ClosingInvitation.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import HomeIntroduction from "../components/sections/HomeIntroduction.astro";
import HomeRecentReflections from "../components/sections/HomeRecentReflections.astro";
import HomeReflectionHighlight from "../components/sections/HomeReflectionHighlight.astro";
import HomeVideoHighlight from "../components/sections/HomeVideoHighlight.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  assertContentIntegrity,
  getFeaturedReflection,
  getFeaturedVideo,
  getPublishedReflections,
} from "../lib/content";

// A página inicial preserva a validação global das coleções durante cada build.
await assertContentIntegrity();

const [featuredReflection, featuredVideo, publishedReflections] =
  await Promise.all([
    getFeaturedReflection(),
    getFeaturedVideo(),
    getPublishedReflections(),
  ]);
const recentReflections = publishedReflections.slice(0, 3);
---

<BaseLayout
  title="Padre Claudiano Avelino"
  description="Reflexões e breves homilias sobre espiritualidade católica, oração e encontro com a Palavra de Deus."
  currentPath="/"
  pageType="website"
  structuredDataType="home"
>
  <HomeHero />
  <HomeIntroduction />
  <HomeReflectionHighlight reflection={featuredReflection} />
  <HomeVideoHighlight video={featuredVideo} />
  <HomeRecentReflections reflections={recentReflections} />
  <ClosingInvitation />
</BaseLayout>
