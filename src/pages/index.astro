---
import Container from "../components/base/Container.astro";
import ButtonLink from "../components/base/ButtonLink.astro";
import EditorialStatement from "../components/editorial/EditorialStatement.astro";
import ThemeList from "../components/editorial/ThemeList.astro";
import HomeEditorialAxes from "../components/sections/HomeEditorialAxes.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  assertContentIntegrity,
  getFeaturedReflection,
  getFeaturedVideo,
  getPublishedReflections,
} from "../lib/content";

// A página inicial preserva a validação global das coleções durante cada build.
await assertContentIntegrity();

const [featuredReflection, featuredVideo, publishedReflections] =
  await Promise.all([
    getFeaturedReflection(),
    getFeaturedVideo(),
    getPublishedReflections(),
  ]);
---

<BaseLayout
  title="Padre Claudiano Avelino"
  description="Reflexões e breves homilias sobre espiritualidade católica, oração e encontro com a Palavra de Deus."
  currentPath="/"
  pageType="website"
  structuredDataType="home"
>
  <div class="home-reference-stage">
    <HomeHero />
    <EditorialStatement id="inicio-declaracao">
      Um espaço pessoal de espiritualidade católica, reflexão e encontro com a
      Palavra, no qual fé, experiência pastoral e pensamento se aproximam da
      vida cotidiana.
    </EditorialStatement>
    <HomeEditorialAxes
      reflection={featuredReflection ?? publishedReflections[0]}
      video={featuredVideo}
    />
    <section id="inicio-temas" class="home-themes">
      <Container>
        <div class="home-themes__heading">
          <p class="type-meta">Temas</p>
          <h2>Cinco caminhos de reflexão</h2>
        </div>
        <ThemeList />
      </Container>
    </section>
  </div>
  <section id="inicio-encerramento" class="home-closing">
    <Container>
      <div class="home-closing__inner">
        <p class="home-closing__words">
          Espiritualidade católica <i>Reflexão</i> Encontro com a Palavra
        </p>
        <ButtonLink href="/sobre/" variant="secondary">
          Conhecer a trajetória
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
