---
import { Picture } from "astro:assets";
import saintJerome from "../assets/art/public-domain/antonello-saint-jerome-study.jpg";
import RenaissanceArtwork from "../components/art/RenaissanceArtwork.astro";
import Container from "../components/base/Container.astro";
import EditorialLink from "../components/base/EditorialLink.astro";
import ThemeList from "../components/editorial/ThemeList.astro";
import { siteMedia } from "../config/media";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sobre | Padre Claudiano Avelino"
  description="Conheça a trajetória de Padre Claudiano Avelino e os temas que orientam suas reflexões."
  currentPath="/sobre/"
  pageType="profile"
  socialImage={siteMedia.aboutPortrait?.src}
  socialImageAlt={siteMedia.aboutPortrait?.alt}
  structuredDataType="profile"
>
  <section id="sobre-abertura" class="about-opening">
    <Container>
      <div class="about-opening__copy">
        <p class="type-meta">Sobre</p>
        <h1>Sobre</h1>
        <p class="type-body-large">
          Natural de Valente, na Bahia, Padre Claudiano Avelino é sacerdote e
          religioso paulino. Sua trajetória reúne espiritualidade, comunicação,
          formação e trabalho editorial.
        </p>
      </div>
      <div class="about-opening__art about-sacred-study" aria-hidden="true">
        <RenaissanceArtwork
          src={saintJerome}
          objectPosition="50% 43%"
          sizes="(max-width: 47.999rem) 100vw, 58vw"
        />
      </div>
    </Container>
  </section>

  <section id="sobre-biografia" class="about-biography-section">
    <Container class="about-biography">
      <div class="about-biography__copy">
        <p class="type-meta">Trajetória</p>
        <h2>Uma trajetória dedicada à Palavra e à comunicação</h2>
        <div class="about-biography__text">
          <p>
            Padre Claudiano Avelino é mestre em Filosofia pela Pontifícia
            Universidade Católica de São Paulo (PUC-SP) e doutor pela
            Universidade Federal de São Paulo (UNIFESP).
          </p>
          <p>
            Ao longo de sua caminhada, tem se dedicado à espiritualidade, à
            formação, à vida pastoral, à comunicação e ao trabalho editorial.
            Sua atuação procura aproximar a profundidade da fé das questões
            concretas que atravessam a experiência cotidiana.
          </p>
          <p>
            Este site nasce como um espaço pessoal de partilha. Nele, reflexões
            e breves homilias convidam à escuta, à oração e ao encontro com a
            Palavra.
          </p>
        </div>
      </div>
      <div class="about-biography__visual">
        {
          siteMedia.aboutPortrait && (
            <Picture
              class="about-biography__photo"
              src={siteMedia.aboutPortrait.src}
              alt={siteMedia.aboutPortrait.alt}
              formats={["avif", "webp"]}
              widths={[360, 480, 720, 960]}
              sizes="(max-width: 47.999rem) calc(100vw - 2.5rem), 40vw"
              quality={80}
              loading="lazy"
              style={`object-position: ${siteMedia.aboutPortrait.objectPosition}`}
            />
          )
        }
      </div>
    </Container>
  </section>

  <section id="sobre-posicionamento" class="about-positioning">
    <Container>
      <p>Fé, experiência pastoral e pensamento próximos da vida cotidiana.</p>
    </Container>
  </section>

  <section id="sobre-temas" class="about-themes">
    <Container>
      <header class="about-themes__heading">
        <p class="type-meta">Núcleos editoriais</p>
        <h2>O que orienta suas reflexões</h2>
      </header>
      <ThemeList variant="about" />
    </Container>
    <div class="about-themes__closing">
      <Container>
        <EditorialLink href="/videos/">Conhecer as homilias</EditorialLink>
      </Container>
    </div>
  </section>
</BaseLayout>
