---
import Container from "../../components/base/Container.astro";
import EditorialLink from "../../components/base/EditorialLink.astro";
import ThemeList from "../../components/editorial/ThemeList.astro";
import FeaturedReflection from "../../components/reflections/FeaturedReflection.astro";
import ReflectionCard from "../../components/reflections/ReflectionCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  assertContentIntegrity,
  getFeaturedReflection,
  getPublishedReflections,
} from "../../lib/content";
import { excludeFeaturedFromListing } from "../../lib/reflections";

await assertContentIntegrity();
const [publishedReflections, featuredReflection] = await Promise.all([
  getPublishedReflections(),
  getFeaturedReflection(),
]);
const listedReflections = excludeFeaturedFromListing(
  publishedReflections,
  featuredReflection,
);
const hasReflections = Boolean(featuredReflection || listedReflections.length);
---

<BaseLayout
  title="Reflexões | Padre Claudiano Avelino"
  description="Textos sobre o Evangelho, a oração, a vida espiritual e os desafios cotidianos."
  currentPath="/reflexoes/"
  structuredDataType="collection"
>
  <section id="reflexoes-abertura" class="collection-opening">
    <Container>
      <p class="collection-opening__number" aria-hidden="true">01</p>
      <div>
        <p class="type-meta">Reflexões</p>
        <h1>Reflexões para o caminho</h1>
        <p class="type-body-large">
          Textos sobre o Evangelho, a oração, a vida espiritual e os desafios
          cotidianos, escritos para serem lidos com calma e levados à oração.
        </p>
      </div>
    </Container>
  </section>

  {
    hasReflections ? (
      <>
        {featuredReflection && (
          <FeaturedReflection
            reflection={featuredReflection}
            id="reflexoes-destaque"
          />
        )}
        <section id="reflexoes-acervo" class="reflections-archive">
          <Container variant="cards">
            <h2>Acervo de reflexões</h2>
            <div class="reflections-grid">
              {listedReflections.map((reflection) => (
                <ReflectionCard {reflection} headingLevel="h3" />
              ))}
            </div>
          </Container>
        </section>
      </>
    ) : (
      <section id="reflexoes-proposta" class="empty-editorial">
        <Container>
          <div class="empty-editorial__intro">
            <p class="type-meta">Proposta editorial</p>
            <h2>Palavra, pensamento e comunicação</h2>
            <p class="type-editorial">
              A espiritualidade, nesse caminho, não se reduz a respostas
              prontas. Ela também envolve silêncio, escuta, discernimento e
              atenção ao modo como a fé encontra a vida.
            </p>
          </div>
          <ThemeList variant="compact" />
          <div class="empty-editorial__footer">
            <p>Novos textos a cada duas semanas.</p>
            <EditorialLink href="/sobre/">Conhecer a trajetória</EditorialLink>
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
