---
import creationAdam from "../assets/art/public-domain/michelangelo-creation-adam-full.jpg";
import RenaissanceArtwork from "../components/art/RenaissanceArtwork.astro";
import Container from "../components/base/Container.astro";
import EditorialLink from "../components/base/EditorialLink.astro";
import ReflectionCard from "../components/reflections/ReflectionCard.astro";
import FeaturedVideo from "../components/videos/FeaturedVideo.astro";
import VideoCard from "../components/videos/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  assertContentIntegrity,
  getFeaturedVideo,
  getPublishedRelatedReflection,
  getPublishedVideos,
} from "../lib/content";
import { excludeFeaturedVideoFromListing } from "../lib/videos";

await assertContentIntegrity();
const [publishedVideos, featuredVideo] = await Promise.all([
  getPublishedVideos(),
  getFeaturedVideo(),
]);
const listedVideos = excludeFeaturedVideoFromListing(
  publishedVideos,
  featuredVideo,
);
const relatedReflection = featuredVideo
  ? await getPublishedRelatedReflection(featuredVideo)
  : undefined;
const hasVideos = Boolean(featuredVideo || listedVideos.length);
---

<BaseLayout
  title="Vídeos | Padre Claudiano Avelino"
  description="Homilia de 1 minuto: breves reflexões em vídeo a partir da Palavra de Deus."
  currentPath="/videos/"
  structuredDataType="collection"
>
  <section id="videos-abertura" class="videos-editorial-opening">
    <Container>
      <div class="videos-editorial-opening__copy">
        <p class="type-meta">Vídeos</p>
        <h1>Vídeos</h1>
        <p class="type-body-large">
          Uma breve pausa para escutar o Evangelho e levá-lo para a vida. Em
          cada vídeo, Padre Claudiano apresenta uma reflexão simples e direta a
          partir da Palavra de Deus.
        </p>
        <p class="videos-editorial-opening__series">
          Breves reflexões em vídeo a partir da Palavra de Deus.
        </p>
      </div>
      <div class="videos-editorial-opening__visual" aria-hidden="true">
        <RenaissanceArtwork
          src={creationAdam}
          objectPosition="72% 44%"
          sizes="(max-width: 55.999rem) 100vw, 58vw"
        />
      </div>
    </Container>
  </section>

  {
    hasVideos ? (
      <>
        {featuredVideo && (
          <FeaturedVideo video={featuredVideo} id="videos-destaque" />
        )}
        <section id="videos-listagem" class="videos-listing">
          <Container variant="cards">
            <h2>Últimas homilias</h2>
            <div class="videos-grid">
              {listedVideos.map((video) => (
                <VideoCard {video} headingLevel="h3" />
              ))}
            </div>
          </Container>
        </section>
      </>
    ) : (
      <section id="videos-proposta" class="videos-empty-editorial">
        <div class="videos-empty-feature">
          <Container>
            <div class="videos-empty-feature__art" aria-hidden="true" />
            <div class="videos-empty-feature__copy">
              <p class="type-meta">Em destaque</p>
              <h2>Homilia de 1 minuto</h2>
              <p class="type-editorial">
                Em poucos instantes, cada mensagem procura oferecer uma pausa,
                uma pergunta ou um convite para continuar o dia com um novo
                olhar.
              </p>
            </div>
          </Container>
        </div>
        <div class="videos-empty-series">
          <Container>
            <p class="type-meta">Homilia de 1 minuto</p>
            <div class="videos-empty-series__composition" aria-hidden="true" />
          </Container>
        </div>
        <div class="videos-empty-lower">
          <Container>
            <EditorialLink href="/reflexoes/">
              Conhecer as reflexões
            </EditorialLink>
          </Container>
        </div>
        <div class="videos-empty-closing" aria-hidden="true" />
      </section>
    )
  }

  {
    relatedReflection && (
      <section id="videos-reflexao-relacionada">
        <Container variant="cards">
          <h2>Para continuar a reflexão</h2>
          <ReflectionCard
            reflection={relatedReflection}
            headingLevel="h3"
            variant="compact"
          />
        </Container>
      </section>
    )
  }
</BaseLayout>
